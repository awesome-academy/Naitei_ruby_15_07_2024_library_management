<div class="col-lg-2 col-md-6 col-sm-6">
  <div class="item">
    <div class="thumb">
      <%= link_to item.link_path do %>
        <%= item.image_tag %>
      <% end %>
    </div>
    <div class="down-content">
      <% if item.category_name.present? %>
        <span class="category truncate-text"><%= item.category_name %></span>
      <% end %>
      <h4 class="truncate-text"><%= item.display_name %></h4>
      <%= item.explore_link %>
    </div>
  </div>
</div>
