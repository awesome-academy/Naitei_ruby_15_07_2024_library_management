<% provide :title, t(".title") %>
<div class="header d-flex align-items-center justify-content-between">
  <%= render "admin/shared/breadcrumb", class: "d-flex align-items-center" %>
</div>
<div class="row page-container mt-3">
  <div class="col-md-8 mx-auto details">
    <ul class="list-unstyled">
      <li class="list-group-item"><strong><%= t ".user" %>:</strong> <%= @presenter.user %></li>
      <li class="list-group-item"><strong><%= t ".book" %>:</strong> <%= @presenter.book %></li>
      <li class="list-group-item"><strong><%= t ".episode" %>:</strong> <%= @presenter.episode %></li>
      <li class="list-group-item"><strong><%= t ".status" %>:</strong> <%= @presenter.localized_status %></li>
      <% if @presenter.start_time %>
        <li class="list-group-item"><strong><%= t ".start_time" %>:</strong> <%= @presenter.start_time %></li>
      <% end %>
      <% if @presenter.due_date %>
        <li class="list-group-item"><strong><%= t ".due_date" %>:</strong> <%= @presenter.due_date %></li>
      <% end %>
      <% if @presenter.created_at %>
        <li class="list-group-item"><strong><%= t ".created_at" %>:</strong> <%= @presenter.created_at %></li>
      <% end %>
    </ul>
  </div>
</div>
