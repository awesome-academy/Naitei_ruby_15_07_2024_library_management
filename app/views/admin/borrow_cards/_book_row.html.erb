<% index = presenter_counter + 1 %>
<tr>
  <td class="text-center"><%= index %></td>
  <td><%= presenter.book %></td>
  <td><%= presenter.episode %></td>
  <td><%= presenter.lost_reason %></td>
  <td class="text-center">
    <span class="<%= presenter.status_badge_class %>">
      <%= presenter.formatted_status %>
    </span>
  </td>

  <td class="text-right pr-5">
    <% if action_type == :return %>
      <%= link_to returned_admin_borrow_book_path(presenter.borrow_book), data: { turbo_method: :patch }, class: "btn btn-success" do %>
        <i class="fas fa-check"></i>
      <% end %>
      <%= link_to lost_admin_borrow_book_path(presenter.borrow_book), data: { turbo_method: :patch }, class: "btn btn-danger" do %>
        <i class="fas fa-xmark"></i>
      <% end %>
    <% elsif action_type == :borrow %>
      <%= link_to confirm_admin_borrow_book_path(presenter.borrow_book), data: { turbo_method: :patch }, class: "btn btn-success" do %>
        <i class="fas fa-check"></i>
      <% end %>
      <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-<%= presenter.borrow_book.id %>">
        <i class="fas fa-xmark"></i>
      </button>
      <%= render "admin/borrow_books/reject_modal", borrow_book: presenter.borrow_book %>
    <% end %>
    <%= link_to admin_borrow_book_path(presenter.borrow_book), class: "btn btn-primary" do %>
      <i class="fas fa-magnifying-glass"></i>
    <% end %>
  </td>
</tr>
